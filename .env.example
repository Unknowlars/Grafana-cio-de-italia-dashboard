TZ=Europe/Copenhagen

LGTM_IMAGE=grafana/otel-lgtm:latest
RENDERER_IMAGE=grafana/grafana-image-renderer:latest

# Demo credentials. Change these for anything beyond local testing.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Required by the Grafana image renderer. Use any long random string.
RENDERER_TOKEN=change-me-to-any-long-random-string

# Ports
GRAFANA_PORT=3009
GIRO_DATA_PORT=8088
PROMETHEUS_PORT=9092
TEMPO_PORT=3200
LOKI_PORT=3400
PYROSCOPE_PORT=3500
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Giro data service
GIRO_BASE=https://www.giroditalia.it/en
GIRO_CACHE_TTL_SEC=45
GIRO_FETCH_TIMEOUT_SEC=12

# Resources
GIRO_DATA_CPUS=0.5
GIRO_DATA_MEM_LIMIT=512m
LGTM_CPUS=4.0
LGTM_MEM_LIMIT=4g
RENDERER_CPUS=1.0
RENDERER_MEM_LIMIT=1g
RENDERER_SHM_SIZE=256m

# Docker logs
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3

# Loki
LOKI_ARGS=--pattern-ingester.enabled=true
