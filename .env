TZ=Europe/Copenhagen

ALLOY_IMAGE=grafana/alloy:latest
LGTM_IMAGE=grafana/otel-lgtm:latest
RENDERER_IMAGE=grafana/grafana-image-renderer:latest

# Demo credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Replace this even for a demo
RENDERER_TOKEN=cc5030ed74bca942bfc39c26e5a13a6a1ae8f7906b753f31ddf8c232fb3b669d

# Ports
GRAFANA_PORT=3009
PROMETHEUS_PORT=9092
TEMPO_PORT=3200
LOKI_PORT=3400
PYROSCOPE_PORT=3500
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12346
SYSLOG_PORT=1514

# Resources
ALLOY_CPUS=2.0
ALLOY_MEM_LIMIT=2g
LGTM_CPUS=4.0
LGTM_MEM_LIMIT=4g
RENDERER_CPUS=1.0
RENDERER_MEM_LIMIT=1g
RENDERER_SHM_SIZE=256m

# Docker logs
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3

# Loki
LOKI_ARGS=--pattern-ingester.enabled=true